middle;strokeWidth=1;spacing=2;" vertex="1" parent="1"><mxGeometry x="320" y="662" width="480" height="20" as="geometry"/></mxCell><mxCell id="n75" value="" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;startArrow=none;startFill=1;strokeWidth=3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="560.0" y="682" as="sourcePoint"/><mxPoint x="560.0" y="735" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n76" value="to Gripper &amp;amp; Object Handling - Connector 1&lt;br&gt;(8-pin ribbon cable)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=8;spacing=0;" vertex="1" parent="1"><mxGeometry x="570.0" y="722" width="330" height="30" as="geometry"/></mxCell><mxCell id="n77" value="Inputs SAFE_OK, RUN_REQ, OBJ_HELD have 10 kOhm pull-downs (cable unplugged = 0 = stop). Outputs GRIP_CMD, ARM_IN_POS have 330 Ohm series resistors.&lt;br&gt;SPEED_SET has a 1 kOhm / 0.1 uF RC filter (fc = 1.6 kHz). Pin 7 (GRIP_FORCE) is not used on this board and left open; pin 8 = GND.&lt;br&gt;Power: supply wiring is not drawn; the rail each block runs from is written in bold inside the block. All grounds (USB, 9 V supply, H-bridge, ribbon pin 8) are common." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=9;spacing=0;" vertex="1" parent="1"><mxGeometry x="30" y="790" width="1060" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
